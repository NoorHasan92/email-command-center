generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
  ULTRA
  ADMIN
}

enum EmailCategory {
  SPAM
  NEWSLETTER
  NOTIFICATION
  DIRECT_MESSAGE
  URGENT
  OTHER
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OpportunityType {
  INTERNSHIP
  JOB
  HACKATHON
  SCHOLARSHIP
  COMPETITION
  COLLEGE_NOTICE
  EXAM
  INTERVIEW
  PAYMENT
  SECURITY_ALERT
  NONE
}

enum DeadlineType {
  HARD
  SOFT
  EVENT
  REMINDER
}

enum SenderReputation {
  TRUSTED
  FREQUENT
  NEW
  SUSPICIOUS
}

enum FeedbackType {
  CORRECT
  WRONG
  IGNORE_SIMILAR
  ALWAYS_NOTIFY
  NEVER_NOTIFY
}

enum RuleType {
  SENDER
  DOMAIN
  SUBJECT_PATTERN
  KEYWORD
  OPPORTUNITY_TYPE
  CATEGORY
}

enum ReminderPriority {
  LOW
  MEDIUM
  HIGH
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PROFILE_UPDATED
  ACCOUNT_LOCKED
  ACCOUNT_REGISTERED
  ACCOUNT_LINK_SUCCESS
  ACCOUNT_LINK_FAILED_EMAIL_MISMATCH
  ACCOUNT_LINK_FAILED_ALREADY_LINKED
  GMAIL_CONNECT_STARTED
  GMAIL_CONNECTED
  GMAIL_CONNECT_FAILED
  GMAIL_WATCH_REGISTERED
  GMAIL_WATCH_FAILED
}

enum SyncStatus {
  PENDING
  ACTIVE
  EXPIRED
  ERROR
}

enum EmailStatus {
  SYNCED
  QUEUED_FOR_AI
  AI_PROCESSING
  AI_COMPLETE
  AI_FAILED
  NOTIFIED
  SKIPPED
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
  TELEGRAM
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model User {
  id                    String    @id @default(cuid())
  name                  String?
  email                 String    @unique
  emailVerified         DateTime?
  image                 String?
  passwordHash          String?
  role                  Role      @default(USER)
  plan                  Plan      @default(FREE)
  isDeleted             Boolean   @default(false)
  deletedAt             DateTime?
  deletedBy             String?

  // Contact Info — WhatsApp
  phoneNumber           String?
  whatsappOptIn         Boolean   @default(false)

  // Contact Info — Telegram
  telegramChatId        String?   // Set when user links via bot
  telegramUsername       String?   // Display name from Telegram
  telegramOptIn         Boolean   @default(false)
  telegramLinkToken     String?   @unique // Temporary token for linking

  // Notification Preferences — JSON array of enabled channels e.g. ["WHATSAPP", "TELEGRAM"]
  notifyChannels        Json      @default("[]")

  // App Preferences — Calendar automation, smart drafts, etc.
  appPreferences        Json      @default("{}")

  // Account Lockout
  failedLoginAttempts   Int       @default(0)
  lockedUntil           DateTime?
  lastLoginAt           DateTime?
  lastFailedLoginAt     DateTime?

  // TOTP
  totpSecret            String?   // Encrypted
  totpRecoveryCodes     String?   // Encrypted array/string

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  accounts              Account[]
  emailAccounts         EmailAccount[]
  sessions              Session[]
  auditLogs             AuditLog[]
  notificationRules     NotificationRule[]
  senderProfiles        SenderProfile[]
  learningRules         UserLearningRule[]
  whatsappVerifications WhatsAppVerification[]
  accountLinkRequests   AccountLinkRequest[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text // Encrypted at rest
  access_token       String?  @db.Text // Encrypted at rest
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  
  // Device Metadata
  userAgent    String?
  ipAddress    String?
  deviceType   String?
  browser      String?
  os           String?

  lastActivityAt DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model AuditLog {
  id        String       @id @default(cuid())
  userId    String?
  action    AuditAction
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model EmailAccount {
  id                String       @id @default(cuid())
  userId            String
  provider          String       // 'gmail', 'outlook', etc.
  providerAccountId String       // Unique ID from the provider
  emailAddress      String
  
  // Encrypted OAuth Tokens
  accessToken       String       @db.Text
  refreshToken      String?      @db.Text
  expiresAt         Int?
  
  // Gmail Sync State
  lastHistoryId     String? 
  watchExpiration   DateTime?
  syncStatus        SyncStatus   @default(PENDING)
  lastSyncedAt      DateTime?

  // Resumable Initial Sync
  nextPageToken       String?  

  // Sync Metrics
  lastSyncStartedAt   DateTime?
  lastSyncCompletedAt DateTime?
  lastSyncDurationMs  Int?
  lastSyncError       String?  @db.Text
  totalEmailsSynced   Int      @default(0)

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails            Email[]

  @@unique([provider, providerAccountId])
}

model WebhookEvent {
  id         String   @id @default(cuid())
  provider   String   // e.g., 'gmail'
  payload    Json     // The raw webhook payload
  processed  Boolean  @default(false)
  status     String   @default("PENDING") // PENDING, PROCESSED, FAILED
  retryCount Int      @default(0)
  error      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Email {
  id                String       @id @default(cuid())
  emailAccountId    String       
  providerMessageId String
  threadId          String?

  subject           String?
  from              String
  to                String
  date              DateTime
  plainText         String?      @db.Text
  htmlBody          String?      @db.Text
  status            EmailStatus  @default(SYNCED)
  retryCount        Int          @default(0)
  pipelineMetrics   Json?        // Stores latency details
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  emailAccount      EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  analysis          EmailAnalysis?
  notificationLogs  NotificationLog[]

  @@unique([emailAccountId, providerMessageId])
}

model EmailAnalysis {
  id                 String   @id @default(cuid())
  emailId            String   @unique

  summary              String   @db.Text
  category             String
  priority             String
  confidence           Int      @default(0)
  requiresAction       Boolean  @default(false)
  reasoning            String   @db.Text
  deadline             DateTime?
  actionItems          Json?
  entities             Json?
  sentiment            String?
  urgencyScore         Int      @default(0)
  estimatedReadingTime Int?
  suggestedNotification Boolean @default(false)
  smartDraft           String?  @db.Text
  extractedEvents      Json?
  
  // AI Cost & Performance Tracking
  model              String?
  promptTokens       Int      @default(0)
  completionTokens   Int      @default(0)
  totalTokens        Int      @default(0)
  estimatedCost      Float    @default(0.0) // In USD
  latencyMs          Int      @default(0)
  finishReason       String?

  // Prompt Versioning
  promptVersion      String   @default("1.0")
  modelVersion       String   @default("gemini-2.5-flash") 
  aiProvider         String   @default("GEMINI")
  aiAnalysisVersion  String   @default("v2") 
  aiVersion          String   @default("2.0-gemini-2.5-flash")

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  email              Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)
}

model NotificationRule {
  id                String              @id @default(cuid())
  userId            String
  appliedAccounts   String[]            @default([])
  minScoreThreshold Int                 @default(50)
  channel           NotificationChannel @default(WHATSAPP)
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationLog {
  id           String             @id @default(cuid())
  emailId      String
  channel      NotificationChannel
  status       NotificationStatus @default(PENDING)
  
  // WhatsApp Delivery Tracking
  providerMessageId String?       @unique // Meta's wamid
  error             String?       @db.Text
  retryCount        Int           @default(0)

  dispatchedAt DateTime?
  createdAt    DateTime           @default(now())

  email        Email              @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@unique([emailId, channel])
}

model SenderProfile {
  id                String           @id @default(cuid())
  userId            String
  emailAddress      String
  reputation        SenderReputation @default(NEW)
  
  // Tracking
  emailsReceived    Int              @default(0)
  notificationsSent Int              @default(0)
  actionsTaken      Int              @default(0)
  ignoredCount      Int              @default(0)
  lastInteractionAt DateTime?

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, emailAddress])
}

model WhatsAppVerification {
  id              String   @id @default(cuid())
  userId          String
  phoneNumber     String
  whatsappCode    String   
  emailCode       String   
  whatsappVerified Boolean @default(false)
  emailVerified    Boolean @default(false)
  expiresAt       DateTime
  attempts        Int      @default(0) 
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserLearningRule {
  id              String       @id @default(cuid())
  userId          String
  ruleType        RuleType
  pattern         String       // The actual keyword/domain/etc
  feedbackType    FeedbackType
  weight          Int          @default(1) // To allow user-defined to take precedence over learned
  isUserDefined   Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AIEvalRun {
  id                    String         @id @default(cuid())
  datasetName           String
  promptVersion         String
  modelVersion          String
  totalEmails           Int            @default(0)
  
  // Aggregate Metrics
  accuracy              Float          @default(0.0)
  precision             Float          @default(0.0)
  recall                Float          @default(0.0)
  f1Score               Float          @default(0.0)
  opportunityAccuracy   Float          @default(0.0)
  deadlineAccuracy      Float          @default(0.0)
  notificationAccuracy  Float          @default(0.0)
  
  totalCost             Float          @default(0.0)
  averageLatencyMs      Float          @default(0.0)
  
  createdAt             DateTime       @default(now())
  
  results               AIEvalResult[]
}

model AIEvalResult {
  id                    String         @id @default(cuid())
  runId                 String
  
  // The email content being tested
  emailSubject          String
  emailFrom             String
  emailBody             String         @db.Text
  
  // Expected vs Actual
  expectedCategory      EmailCategory
  actualCategory        EmailCategory
  expectedActionReq     Boolean
  actualActionReq       Boolean
  expectedOpportunity   Boolean
  actualOpportunity     Boolean
  expectedNotification  Boolean
  actualNotification    Boolean
  
  // Performance
  latencyMs             Int
  cost                  Float
  
  // Flags
  isFalsePositive       Boolean        @default(false)
  isFalseNegative       Boolean        @default(false)
  isPerfectMatch        Boolean        @default(false)
  
  createdAt             DateTime       @default(now())
  
  run                   AIEvalRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model WhatsAppSession {
  id        String   @id @default(cuid())
  userId    String
  sessionId String   // Usually the userId, but can support multiple devices
  category  String   // "creds" or "keys"
  key       String   // e.g., "app-state-sync-key-..." or "creds"
  data      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, sessionId, category, key])
}

model AccountLinkRequest {
  id            String   @id @default(cuid())
  userId        String   // The primary user initiating the request
  targetEmail   String   // The secondary email they want to link
  
  primaryCode   String   // Alphanumeric code sent to primary email
  secondaryCode String   // Alphanumeric code sent to secondary email
  linkToken     String   @unique // Secure token for the final OAuth link
  
  expiresAt     DateTime
  status        String   @default("PENDING_CODES") // PENDING_CODES, PENDING_OAUTH, LINKED
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
